# MongoDB Connection String (e.g. mongodb+srv://user:pass@cluster.mongodb.net/mplads_audit or mongodb://localhost:27017/mplads)
MONGODB_URI="your_mongodb_connection_string"

# JWT Secret for session authentication tokens
JWT_SECRET="your_long_random_jwt_secret_key_here"

# Gemini API Key (optional: used for generating plain-English executive summaries of deterministic audit findings)
GEMINI_API_KEY="your_gemini_api_key"

# Gmail SMTP for real report delivery (optional)
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_gmail_app_password"

# Server configuration
PORT=3000

